# Copy to .env and adjust before running `docker compose up`.

# PostgreSQL password (used by db, migrate, and backend).
POSTGRES_PASSWORD=password

# JWT signing secret, at least 32 random characters.
JWT_SECRET=CHANGE_ME_DEV_ONLY_REPLACE_WITH_A_LONG_RANDOM_SECRET

# Host port for the reverse proxy (single entry point for frontend + API).
PROXY_PORT=8081

# Leave empty so the frontend calls the API via relative paths through the
# proxy. Setting an absolute URL bakes it into the build and breaks access
# from any other host (the nginx CSP only allows same-origin API calls).
VITE_API_BASE_URL=

# Only used by the Cloudflare worker-backend (via wrangler vars), not by
# docker compose. The .NET backend's CORS policy allows any origin.
FRONTEND_ORIGIN=http://localhost:8081

# Alert notification targets (all optional; leave empty to disable).
# Alerts always appear in the dashboard regardless of these settings.
ALERT_WEBHOOK_URL=
ALERT_DISCORD_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
