# Copy to .env and adjust before running `docker compose up`.

# PostgreSQL password (used by db, migrate, and backend).
POSTGRES_PASSWORD=password

# JWT signing secret, at least 32 random characters.
JWT_SECRET=CHANGE_ME_DEV_ONLY_REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ISSUER=NetraScope
JWT_AUDIENCE=NetraScope
# Dashboard login token lifetime in minutes (129600 = 90 days).
JWT_EXPIRY_MINUTES=129600
ASPNETCORE_ENVIRONMENT=Production

# Dashboard authentication controls.
AUTH_ALLOW_REGISTRATION=true
AUTH_RATE_LIMIT_PERMIT_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
METRICS_RATE_LIMIT_PERMIT_LIMIT=600
METRICS_RATE_LIMIT_WINDOW_SECONDS=60

# Host port for the reverse proxy (single entry point for frontend + API).
PROXY_PORT=8081

# Leave empty so the frontend calls the API via relative paths through the
# proxy. Setting an absolute URL bakes it into the build and breaks access
# from any other host (the nginx CSP only allows same-origin API calls).
VITE_API_BASE_URL=

# Alert notification targets (all optional; leave empty to disable).
# Alerts always appear in the dashboard regardless of these settings.
ALERT_WEBHOOK_URL=
ALERT_EMAIL_WEBHOOK_URL=
ALERT_DISCORD_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERTING_ENABLED=true
ALERT_CPU_THRESHOLD_PCT=90
ALERT_CPU_SUSTAINED_MINUTES=5
ALERT_MEMORY_THRESHOLD_PCT=90
ALERT_DISK_THRESHOLD_PCT=85
ALERT_CPU_TEMP_THRESHOLD_C=85
ALERT_OFFLINE_MINUTES=2

# Metric history retention and rollup maintenance.
METRIC_RETENTION_ENABLED=true
METRIC_RAW_RETENTION_DAYS=30
METRIC_FIVE_MINUTE_RETENTION_DAYS=90
METRIC_HOUR_RETENTION_DAYS=365
METRIC_MAINTENANCE_INTERVAL_MINUTES=5
METRIC_FIVE_MINUTE_LOOKBACK_MINUTES=90
METRIC_HOUR_LOOKBACK_MINUTES=180
